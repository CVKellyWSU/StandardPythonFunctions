def run_ilastik_masking(ilastik_exec, project_file, input_image, output_dir):
    """
    Runs an ilastik pixel classification project headless to generate a mask.
    """
    # Ensure output directory exists
    os.makedirs(output_dir, exist_ok=True)
    
    # Define the output format and naming convention
    # {nickname} grabs the original file name without the extension
    output_pattern = os.path.join(output_dir, "{nickname}_mask.tiff")
    
    # Build the command list
    cmd = [
        ilastik_exec,
        "--headless",
        f"--project={project_file}",
        "--export_source=Simple Segmentation", # Use "Probabilities" if you want raw confidence maps
        "--output_format=tiff",
        f"--output_filename_format={output_pattern}",
        input_image
    ]
    
    print(f"Running ilastik on {input_image}...")
    
    # Execute the command
    try:
        result = subprocess.run(cmd, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        print("ilastik processing complete!")
    except subprocess.CalledProcessError as e:
        print(f"Error running ilastik:\n{e.stderr}")
        return None

    # Reconstruct the expected output path to load it back into Python
    base_name = os.path.splitext(os.path.basename(input_image))[0]
    expected_output_path = os.path.join(output_dir, f"{base_name}_mask.tiff")
    
    # Load the mask as a numpy array
    if os.path.exists(expected_output_path):
        mask = tifffile.imread(expected_output_path)
        return mask
    else:
        print("Output mask not found. Check ilastik export settings.")
        return None

